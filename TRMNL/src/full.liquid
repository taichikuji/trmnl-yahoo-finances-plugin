<div class="layout layout--col layout--top gap--small p--5" data-stonks>
  <div class="flex flex--row flex--between w--full no-shrink">
    <span class="title">Nutanix Inc.</span>
    <span class="label label--small">NASDAQ:NTNX</span>
  </div>
  {% if stonks.has_data == true %}
    <div class="flex flex--row flex--left gap--small w--full no-shrink">
      <span class="value value--tnums">{{ stonks.price_label | escape }}</span>
      <span class="label label--small">USD</span>
      <span class="value value--xxsmall value--tnums">{{ stonks.change_label | escape }}</span>
      <span class="label label--small">Past year</span>
    </div>
    <div class="flex flex--row flex--between w--full no-shrink">
      <span class="description">{{ stonks.detail | escape }}</span>
      {% if stonks.stale == true %}<span class="label label--small label--filled">STALE DATA</span>{% endif %}
    </div>
    <div class="stretch w--full h--min-0">
      <svg class="block" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 756 306" preserveAspectRatio="none" role="img" aria-label="Nutanix stock price over one year in US dollars">
        <title>Nutanix, one year of daily prices. Latest price {{ stonks.price_label | escape }} USD.</title>
        {% for tick in stonks.ticks %}
          <line x1="707" x2="711" y1="{{ tick.y }}" y2="{{ tick.y }}" stroke="currentColor" stroke-width=".6" />
          <text class="text--small" x="718" y="{{ tick.y }}" fill="currentColor" dominant-baseline="middle">{{ tick.label | escape }}</text>
        {% endfor %}
        <path data-stonks-line d="{{ stonks.path | escape }}" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
        {% for date in stonks.dates %}
          <text class="text--small" x="{{ date.x }}" y="300" fill="currentColor" text-anchor="{% if forloop.first %}start{% elsif forloop.last %}end{% else %}middle{% endif %}">{{ date.label | escape }}</text>
        {% endfor %}
      </svg>
    </div>
  {% else %}
    <div class="stretch flex flex--col flex--center gap--large text--center">
      <span class="title title--large">DATA UNAVAILABLE</span>
      <span class="description">No validated prices have been saved yet.<br />The next scheduled refresh will try again.</span>
      <span class="description">{{ stonks.detail | default: 'Market data could not be loaded' | escape }}</span>
    </div>
  {% endif %}
</div>
<div class="title_bar">
  <span class="title">STONKS</span>
  <span class="instance">{% if stonks.has_data == true %}Market data: {{ stonks.market_label | escape }}{% else %}NTNX · 1 year · USD{% endif %}</span>
</div>
