<div class="layout layout--col layout--top gap--small p--2" data-stonks style="--stonks-font: {{ font_size }}px;">
  {% render 'stonks_heading', stonks: stonks, header: header, size: 'title--small lg:title--base' %}
  {% if stonks.has_data == true %}
    <div class="flex flex--row flex--wrap flex--between flex--bottom gap--xsmall w--full no-shrink">
      {% render 'stonks_price', stonks: stonks, header: header, size: 'value--base lg:landscape:value--large', large_size: 'value--base lg:value--large' %}
      {% render 'stonks_return', stonks: stonks, words: words, direction: direction, range_label: range_label %}
    </div>
    {% render 'stonks_status', stonks: stonks, words: words %}
    {% render 'stonks_chart', stonks: stonks, fields: fields, direction: direction, range_label: range_label, line_width: line_width %}
  {% else %}
    {% render 'stonks_unavailable', stonks: stonks, words: words %}
  {% endif %}
</div>
{% render 'stonks_footer', stonks: stonks, words: words, range_label: range_label, svg_logo: svg_logo, title: trmnl.plugin_settings.instance_name %}
