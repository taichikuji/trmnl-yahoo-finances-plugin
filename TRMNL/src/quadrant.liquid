<div class="layout layout--col layout--top gap--small p--2" data-market-view data-label-class="{{ label_class }}">
  {% render 'quote_header', quote: quote, heading_size: heading_size, size: 'title--small' %}
  {% if quote.has_data == true %}
    <div class="flex flex--row flex--wrap flex--between flex--bottom gap--xsmall w--full no-shrink">
      {% render 'quote_price', quote: quote, heading_size: heading_size, size: 'value--small lg:value--base', large_size: 'value--base lg:value--large' %}
      {% render 'quote_change', label_class: label_class, quote: quote, words: words, direction: direction, range_label: range_label %}
    </div>
    {% render 'chart_section', label_class: label_class, quote: quote, words: words, fields: fields, direction: direction, range_label: range_label, line_width: line_width %}
  {% else %}
    {% render 'unavailable_message', label_class: label_class, quote: quote, words: words %}
  {% endif %}
</div>
{% render 'title_bar', quote: quote, words: words, range_label: range_label, svg_logo: svg_logo, title: trmnl.plugin_settings.instance_name %}
