            {% assign fill_directions = 'up,down,flat' | split: ',' %}
            {% for fill_direction in fill_directions %}
              {% capture fill_color %}{% if fill_direction == 'flat' %}currentColor{% else %}var(--chart-{{ fill_direction }}-color){% endif %}{% endcapture %}
              <linearGradient id="{{ clip_id }}-fill-{{ fill_direction }}" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="{{ fill_color }}" stop-opacity=".22" />
                <stop offset="100%" stop-color="{{ fill_color }}" stop-opacity=".02" />
              </linearGradient>
            {% endfor %}
          </defs>
          {% if show_reference == 'true' or show_reference == 'show' %}
            <path data-chart-area-fill style="--chart-dither:url(#{{ clip_id }}-dots)" d="{{ area_path | escape }}" fill="url(#{{ clip_id }}-fill-up)" clip-path="url(#{{ clip_id }}-above)" />
            <path data-chart-area-fill style="--chart-dither:url(#{{ clip_id }}-dots)" d="{{ area_path | escape }}" fill="url(#{{ clip_id }}-fill-down)" clip-path="url(#{{ clip_id }}-below)" />
          {% else %}
            <path data-chart-area-fill style="--chart-dither:url(#{{ clip_id }}-dots)" d="{{ area_path | escape }}" fill="url(#{{ clip_id }}-fill-{{ direction }})" />
          {% endif %}
        {% endif %}
        {% if show_gridlines == 'true' or show_gridlines == 'show' %}
          {% for tick in quote.ticks %}<path data-chart-gridline{% if tick.detail %} data-axis-detail{% endif %}{% if tick.middle %} data-axis-middle{% endif %} d="M4,{{ tick.y }}H696" fill="none" stroke="currentColor" {% if filled %}stroke-opacity=".18"{% else %}stroke-dasharray="4 6"{% endif %} stroke-width="1" vector-effect="non-scaling-stroke" />{% endfor %}
          {% for date in quote.dates %}<path data-chart-gridline d="M{{ date.x }},12V274" fill="none" stroke="currentColor" {% if filled %}stroke-opacity=".18"{% else %}stroke-dasharray="4 6"{% endif %} stroke-width="1" vector-effect="non-scaling-stroke" />{% endfor %}
        {% endif %}
        {% if show_reference == 'true' or show_reference == 'show' %}<path d="M4,{{ quote.reference_y }}H696" fill="none" stroke="currentColor" stroke-dasharray="6 4" stroke-width="1" vector-effect="non-scaling-stroke" />{% endif %}
        {% if line_path != empty %}
          <g stroke-width="{{ line_width }}" stroke-linecap="round" stroke-linejoin="round">
            {% if show_reference == 'true' or show_reference == 'show' %}
              {% unless filled %}{% assign clip_id = 'price-chart-' | append_random %}{% endunless %}
              {% assign below_height = 286 | minus: quote.reference_y %}
              <defs>
                <clipPath id="{{ clip_id }}-above"><rect x="0" y="0" width="700" height="{{ quote.reference_y }}" /></clipPath>
                <clipPath id="{{ clip_id }}-below"><rect x="0" y="{{ quote.reference_y }}" width="700" height="{{ below_height }}" /></clipPath>
              </defs>
              <path data-chart-line data-chart-above-baseline d="{{ line_path | escape }}" clip-path="url(#{{ clip_id }}-above)" fill="none" stroke="var(--chart-up-color)" vector-effect="non-scaling-stroke" />
              <path data-chart-below-baseline d="{{ line_path | escape }}" clip-path="url(#{{ clip_id }}-below)" fill="none" stroke="var(--chart-down-color)" vector-effect="non-scaling-stroke" />
            {% else %}
              <path data-chart-line d="{{ line_path | escape }}" fill="none" stroke="{% if filled and direction != 'flat' %}var(--chart-{{ direction }}-color){% else %}currentColor{% endif %}" vector-effect="non-scaling-stroke" />
            {% endif %}
          </g>
        {% else %}
          <g data-chart-ohlc stroke="currentColor" stroke-width="1" stroke-linejoin="miter">
            <path data-chart-candle="up" d="{{ up_path | escape }}" stroke="var(--chart-up-color)" fill="{% if quote.chart_type == 'candles' %}var(--chart-up-fill){% else %}none{% endif %}" vector-effect="non-scaling-stroke" />
            <path data-chart-candle="down" d="{{ down_path | escape }}" stroke="var(--chart-down-color)" fill="{% if quote.chart_type == 'candles' %}var(--chart-down-color){% else %}none{% endif %}" vector-effect="non-scaling-stroke" />
            <path data-chart-candle="flat" d="{{ flat_path | escape }}" fill="var(--chart-background)" vector-effect="non-scaling-stroke" />
            <path d="{{ missing_path | escape }}" fill="none" vector-effect="non-scaling-stroke" />
          </g>
        {% endif %}
        {% if quote.has_volume == true %}<path data-chart-volume d="{% for point in quote.volumes %}M{{ point[0] }},274V{{ point[1] }}{% endfor %}" fill="none" stroke="currentColor" stroke-width="{% if filled %}{{ quote.volume_width | at_most: 2 }}{% else %}{{ quote.volume_width }}{% endif %}"{% if filled %} stroke-opacity=".4" stroke-linecap="round" vector-effect="non-scaling-stroke"{% endif %} />{% endif %}
      </svg>
      {% if line_path != empty %}
        <svg class="absolute top--0 left--0 w--full h--full" overflow="visible" aria-hidden="true"><circle data-last-price-marker="{{ direction | escape }}" cx="99.428571%" cy="{{ quote.last_y | times: 100.0 | divided_by: 286.0 }}%" r="4" fill="{% if direction == 'up' %}var(--chart-up-color){% elsif direction == 'down' %}var(--chart-down-color){% else %}currentColor{% endif %}" /></svg>
      {% endif %}
    </div>
    <div class="flex flex--row flex--between gap--xsmall w--full no-shrink">
      {% for date in quote.dates %}<span class="{{ label_class }} no-shrink" data-date-label{% if forloop.index == 2 %} data-middle-date-label{% endif %}>{{ date.label | escape }}</span>{% endfor %}
    </div>
  </div>
  <div class="flex flex--col gap--xsmall h--full no-shrink">
    <div class="stretch relative w--full">
      <svg class="absolute top--0 left--0 w--full h--full" overflow="visible" data-price-axis>
        {% for tick in quote.ticks %}
          <text class="{{ label_class }}" data-price-tick{% if tick.detail %} data-axis-detail{% endif %}{% if tick.middle %} data-axis-middle{% endif %} x="100%" y="{{ tick.y | times: 100.0 | divided_by: 286.0 }}%" text-anchor="end" dominant-baseline="central" fill="currentColor">{{ tick.label | escape }}</text>
        {% endfor %}
        {% if show_reference_label %}<text class="{{ label_class }}" data-reference-label x="100%" y="{{ quote.reference_y | times: 100.0 | divided_by: 286.0 }}%" text-anchor="end" dominant-baseline="central" fill="currentColor">{{ quote.reference_label | escape }}</text>{% endif %}
      </svg>
      <span class="{{ label_class }}" data-axis-spacer aria-hidden="true">{% for tick in quote.ticks %}<span{% if tick.detail %} data-axis-detail{% endif %}{% if tick.middle %} data-axis-middle{% endif %}>{{ tick.label | escape }}<br /></span>{% endfor %}</span>
    </div>
    <span class="{{ label_class }} text--right no-shrink">{{ quote.currency | escape }}</span>
  </div>
</div>
{% endtemplate %}

{% template chart_section %}
{% if quote.charts %}
<div class="stretch flex flex--col w--full w--min-0" data-chart-area>
  {% assign densities = 'normal,compact,detailed' | split: ',' %}
  {% for density in densities %}
    {% assign model = quote.charts[density] | default: quote %}
    <div class="stretch flex flex--col gap--small w--full w--min-0" data-chart-density="{{ density }}">
      {% render 'quote_status', label_class: label_class, quote: model, words: words %}
      {% render 'price_chart', label_class: label_class, quote: model, fields: fields, direction: direction, range_label: range_label, line_width: line_width, reference_gap: reference_gap %}
    </div>
  {% endfor %}
</div>
{% else %}
  {% render 'quote_status', label_class: label_class, quote: quote, words: words %}
  {% render 'price_chart', label_class: label_class, quote: quote, fields: fields, direction: direction, range_label: range_label, line_width: line_width, reference_gap: reference_gap %}
{% endif %}
{% endtemplate %}

{% template unavailable_message %}
<div class="stretch flex flex--col flex--center gap--small text--center w--full">
  <span class="title title--small" data-clamp="1">{{ words[0] | escape }}</span>
  <span class="{{ label_class }} w--full" data-clamp="2" title="{{ quote.detail | escape }}">{{ quote.detail | escape }}</span>
  <span class="{{ label_class }} w--full">{{ words[7] | escape }}.<br />{{ words[2] | escape }}</span>
</div>
{% endtemplate %}

{% template title_bar %}
<div class="title_bar" data-quote-footer>
  <img class="image image--adaptive w--7 h--7" src="data:image/svg+xml;base64,{{ svg_logo | base64_encode }}" alt="STONKS logo">
  <span class="title">{{ title | default: 'STONKS' | escape }}</span>
  <span class="instance">{% if quote.has_data == true %}<time datetime="{{ quote.market_iso | escape }}" title="{{ words[3] | escape }}: {{ quote.market_label | escape }}" aria-label="{{ words[3] | escape }}: {{ quote.market_label | escape }}"><span data-timestamp-full>{{ quote.market_label_compact | escape }}</span><span data-timestamp-short>{{ quote.market_label_compact | slice: -5, 5 | escape }}</span></time>{% else %}{{ quote.symbol | escape }} · {{ range_label | escape }}{% endif %}</span>
</div>
{% endtemplate %}
