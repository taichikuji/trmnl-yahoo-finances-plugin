{% comment %}Shared prepares UI values and defines the components used by each view.{% endcomment %}
{%- capture svg_logo -%}
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">
  <path fill="none" stroke="#000" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" d="M10 12v42h44 M18 42l12-12 10 7 14-20 M42 17h12v12"/>
</svg>
{%- endcapture -%}

{% assign fields = trmnl.plugin_settings.custom_fields_values %}
{% assign header = fields.headerFontSize | default: 'medium' %}
{% assign font_size = fields.fontSize | default: 12 | plus: 0 | at_least: 8 | at_most: 16 %}
{% assign line_width = fields.lineWidth | default: 2 | plus: 0 | at_least: 1 | at_most: 5 %}
{% case fields.locale %}
  {% when 'de_DE' %}{% assign words = 'KEINE DATEN|ALTE DATEN|Erneuter Versuch beim nächsten Update.|Marktdaten|FX-Schätzung|Erweitert|Regulär|Keine gespeicherten Kurse für diese Auswahl|ab erstem Kurs|Gestiegen|Gefallen|Unverändert' | split: '|' %}
  {% when 'fr' %}{% assign words = 'DONNÉES INDISPONIBLES|DONNÉES ANCIENNES|Nouvel essai à la prochaine mise à jour.|Données du marché|Estimation FX|Étendue|Normale|Aucun cours enregistré pour cette sélection|depuis le premier cours|En hausse|En baisse|Inchangé' | split: '|' %}
  {% when 'es' %}{% assign words = 'DATOS NO DISPONIBLES|DATOS ANTIGUOS|Se intentará en la próxima actualización.|Datos de mercado|Estimación FX|Extendida|Regular|Sin precios guardados para esta selección|desde el primer precio|Sube|Baja|Sin cambios' | split: '|' %}
  {% when 'it' %}{% assign words = 'DATI NON DISPONIBILI|DATI NON AGGIORNATI|Nuovo tentativo al prossimo aggiornamento.|Dati di mercato|Stima FX|Estesa|Regolare|Nessun prezzo salvato per questa selezione|dal primo prezzo|In rialzo|In ribasso|Invariato' | split: '|' %}
  {% when 'pl' %}{% assign words = 'BRAK DANYCH|NIEAKTUALNE DANE|Kolejna próba przy następnym odświeżeniu.|Dane rynkowe|Szacunek FX|Rozszerzona|Zwykła|Brak zapisanych cen dla tego wyboru|od pierwszej ceny|Wzrost|Spadek|Bez zmian' | split: '|' %}
  {% else %}{% assign words = 'DATA UNAVAILABLE|STALE DATA|Next refresh will try again.|Market data|FX estimate|Extended|Regular|No saved prices for this selection|from first bar|Up|Down|Unchanged' | split: '|' %}
{% endcase %}
{% case stonks.range %}
  {% when '1d' %}{% assign range_label = '1D' %}
  {% when '1mo' %}{% assign range_label = '1M' %}
  {% when '3mo' %}{% assign range_label = '3M' %}
  {% when '5y' %}{% assign range_label = '5Y' %}
  {% when 'max' %}{% assign range_label = 'ALL' %}
  {% else %}{% assign range_label = '1Y' %}
{% endcase %}
{% assign direction = 'flat' %}
{% if stonks.absolute_change_label contains '+' or stonks.percent_label contains '+' %}
  {% assign direction = 'up' %}
{% elsif stonks.absolute_change_label contains '−' or stonks.percent_label contains '−' %}
  {% assign direction = 'down' %}
{% endif %}
<style>
  [data-stonks] .description, [data-stonks] .label--small { font-size: calc(var(--stonks-font) * var(--text-ui-scale, 1)); }
  /* Framework clamping needs JavaScript; keep the heading bounded without it. */
  [data-stonks-heading] > span { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  [data-stonks] {
    --stonks-paper: var(--framework-semantic-canvas-bg-color, #fff);
    --stonks-ink: var(--framework-semantic-text-primary-text-solid, #000);
    --stonks-rise: var(--stonks-ink);
    --stonks-fall: var(--stonks-ink);
    --stonks-rise-fill: var(--stonks-paper);
    --stonks-gain-accent: var(--stonks-paper);
  }
  /* SVG needs solid paint; text utilities can use clipped dither backgrounds.
     Use the pinned framework's palette tokens and keep grayscale strokes dark. */
  .screen--color-4bwry [data-stonks] {
    --stonks-fall: var(--bg-red-color);
    --stonks-rise-fill: var(--bg-green-color);
    --stonks-gain-accent: var(--bg-green-color);
  }
  :is(.screen--color-6a, .screen--color-7a) [data-stonks] {
    --stonks-rise: var(--bg-green-color);
    --stonks-fall: var(--bg-red-color);
    --stonks-rise-fill: var(--bg-green-color);
  }
  .screen--color-full [data-stonks] {
    --stonks-rise: var(--green-25);
    --stonks-fall: var(--red-30);
    --stonks-rise-fill: var(--green-25);
  }
  [data-stonks] [data-stonks-return="up"] { color: var(--stonks-rise); background-color: var(--stonks-gain-accent); border-color: var(--stonks-rise); }
  [data-stonks] [data-stonks-return="down"] { color: var(--stonks-fall); border-color: var(--stonks-fall); }
  [data-stonks] [data-stonks-change="up"] { color: var(--stonks-rise); }
  [data-stonks] [data-stonks-change="down"] { color: var(--stonks-fall); }
  [data-stonks] [data-stonks-point="up"] { background-color: var(--stonks-rise); }
  [data-stonks] [data-stonks-point="down"] { background-color: var(--stonks-fall); }
  /* Framework breakpoints follow devices; this query follows the actual slot. */
  @container (max-width: 360px) { [data-stonks-mid-date] { display: none; } }
</style>

{% template stonks_heading %}
<div class="flex flex--row flex--between gap--xsmall w--full no-shrink" data-stonks-heading>
  <span class="title {% if header == 'large' %}{{ large_size | default: 'title--base lg:title--large' }}{% elsif header == 'small' %}title--small{% else %}{{ size }}{% endif %} w--min-0" title="{{ stonks.name | default: stonks.symbol | escape }}">{{ stonks.name | default: stonks.symbol | escape }}</span>
  <span class="label label--small no-shrink w--max-[40cqw]" title="{{ stonks.symbol | escape }}">{{ stonks.symbol | escape }}</span>
</div>
{% endtemplate %}

{% template stonks_price %}
{% assign price_characters = stonks.price_label | size %}
<div class="flex flex--row flex--wrap flex--bottom gap--xsmall w--min-0">
  <span class="value {% if price_characters > 15 %}value--xsmall lg:value--small{% elsif price_characters > 10 %}value--small lg:value--base{% elsif header == 'large' %}{{ large_size }}{% elsif header == 'small' %}value--small{% else %}{{ size }}{% endif %} value--tnums no-shrink" data-stonks-price>{{ stonks.price_label | escape }}</span>
  <span class="label label--small pb--1" data-stonks-currency>{{ stonks.currency | escape }}</span>
</div>
{% endtemplate %}

{% template stonks_return %}
{% case direction %}{% when 'up' %}{% assign direction_label = words[9] %}{% when 'down' %}{% assign direction_label = words[10] %}{% else %}{% assign direction_label = words[11] %}{% endcase %}
<div class="flex flex--col flex--left gap--xsmall no-shrink">
  <div class="flex flex--row gap--xsmall">
    <span class="label label--outline flex flex--row gap--xsmall" data-stonks-return="{{ direction | escape }}" aria-label="{{ direction_label | escape }} {{ stonks.percent_label | escape }}% · {{ range_label | escape }}">
      <svg class="w--3 h--3 no-shrink" viewBox="0 0 12 12" aria-hidden="true">
        {% if direction == 'up' %}<path d="M6 1L11 6H8V11H4V6H1Z" fill="currentColor" />{% elsif direction == 'down' %}<path d="M4 1H8V6H11L6 11L1 6H4Z" fill="currentColor" />{% else %}<path d="M1 5H11V7H1Z" fill="currentColor" />{% endif %}
      </svg>
      <span>{{ stonks.percent_label | escape }}%</span>
    </span>
    <span class="label label--small">{{ range_label | escape }}</span>
  </div>
  <span class="description" data-stonks-change="{{ direction | escape }}">{{ stonks.absolute_change_label | escape }} {{ stonks.currency | escape }}</span>
</div>
{% endtemplate %}

{% template stonks_status %}
<div class="flex flex--row flex--between gap--xsmall w--full no-shrink">
  <span class="description w--min-0" data-stonks-status title="{{ stonks.detail | escape }}{% if stonks.fx_iso != '' %} FX: {{ stonks.fx_iso | escape }}{% endif %}">{% if stonks.stale == true %}{{ stonks.detail | escape }}{% else %}{{ stonks.interval | escape }}{% if stonks.group > 1 %} ×{{ stonks.group }}{% endif %} · {% if stonks.extended %}{{ words[5] }}{% else %}{{ words[6] }}{% endif %}{% if stonks.chart_type != 'line' and stonks.has_ohlc != true %} · OHLC unavailable · line shown{% endif %}{% endif %}{% if stonks.fx_iso != '' %} · {{ stonks.native_currency | escape }}→{{ stonks.currency | escape }} · {{ words[4] }}{% endif %}{% if stonks.range == '1d' and stonks.return_basis == 'first_close' %} · {{ words[8] }}{% endif %}</span>
  {% if stonks.stale == true %}<span class="label label--small label--filled no-shrink">{{ words[1] | escape }}</span>{% endif %}
</div>
{% endtemplate %}

{% template stonks_chart %}
{%- assign line_type = fields.lineType | default: '2' | append: '' -%}
{%- capture line_path -%}
  {%- for point in stonks.points -%}
    {%- if forloop.first -%}M{{ point[0] }},{{ point[1] }}
    {%- elsif line_type == '0' -%}L{{ point[0] }},{{ point[1] }}
    {%- elsif line_type == '1' -%}H{{ point[0] }}V{{ point[1] }}
    {%- else -%}
      {%- assign segment_index = forloop.index0 | minus: 1 -%}
      C{{ stonks.curves[segment_index] | join: ',' }}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- assign up_path = '' -%}
{%- assign down_path = '' -%}
{%- assign flat_path = '' -%}
{%- assign missing_path = '' -%}
{%- for candle in stonks.candles -%}
  {%- if candle[3] == nil -%}
    {%- capture missing -%}M{{ candle[1] }},{{ candle[6] }}h{{ stonks.body_width }}{%- endcapture -%}
    {%- assign missing_path = missing_path | append: missing -%}
  {%- else -%}
    {%- capture candle_path -%}
      M{{ candle[0] }},{{ candle[4] }}V{{ candle[5] }}
      {%- if stonks.chart_type == 'bars' -%}
        M{{ candle[1] }},{{ candle[3] }}H{{ candle[0] }}M{{ candle[0] }},{{ candle[6] }}H{{ candle[2] }}
      {%- else -%}
        {%- assign top = candle[3] | at_most: candle[6] -%}
        M{{ candle[1] }},{{ top }}h{{ stonks.body_width }}v{{ candle[7] }}h-{{ stonks.body_width }}Z
      {%- endif -%}
    {%- endcapture -%}
    {%- if candle[8] > 0 -%}{%- assign up_path = up_path | append: candle_path -%}
    {%- elsif candle[8] < 0 -%}{%- assign down_path = down_path | append: candle_path -%}
    {%- else -%}{%- assign flat_path = flat_path | append: candle_path -%}{%- endif -%}
  {%- endif -%}
{%- endfor -%}
<div class="stretch flex flex--row gap--xsmall w--full" data-stonks-chart>
  <div class="stretch flex flex--col gap--xsmall h--full w--min-0">
    <div class="stretch relative w--full">
      <svg class="block" data-stonks-plot xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 700 286" preserveAspectRatio="none" role="img" aria-label="{{ stonks.name | escape }} · {{ range_label | escape }} · {{ stonks.currency | escape }}">
        <title>{{ stonks.symbol | escape }} · {{ stonks.price_label | escape }} {{ stonks.currency | escape }} · {{ stonks.market_label | escape }}</title>
        {% if fields.showGridlines == 'show' %}
          {% for tick in stonks.ticks %}<path d="M4,{{ tick.y }}H696" fill="none" stroke="currentColor" stroke-dasharray="1 6" stroke-width="0.5" vector-effect="non-scaling-stroke" />{% endfor %}
          {% for date in stonks.dates %}<path d="M{{ date.x }},12V274" fill="none" stroke="currentColor" stroke-dasharray="1 6" stroke-width="0.5" vector-effect="non-scaling-stroke" />{% endfor %}
        {% endif %}
        {% if fields.showReference == 'show' %}<path d="M4,{{ stonks.reference_y }}H696" fill="none" stroke="currentColor" stroke-dasharray="6 4" stroke-width="1" vector-effect="non-scaling-stroke" />{% endif %}
        {% if line_path != empty %}
          <g stroke-width="{{ line_width }}" stroke-linecap="round" stroke-linejoin="round">
            {% if fields.showReference == 'show' %}
              {% assign clip_id = 'stonks-' | append_random %}
              {% assign below_height = 286 | minus: stonks.reference_y %}
              <defs>
                <clipPath id="{{ clip_id }}-above"><rect x="0" y="0" width="700" height="{{ stonks.reference_y }}" /></clipPath>
                <clipPath id="{{ clip_id }}-below"><rect x="0" y="{{ stonks.reference_y }}" width="700" height="{{ below_height }}" /></clipPath>
              </defs>
              <path data-stonks-line data-stonks-above d="{{ line_path | escape }}" clip-path="url(#{{ clip_id }}-above)" fill="none" stroke="var(--stonks-rise)" vector-effect="non-scaling-stroke" />
              <path data-stonks-below d="{{ line_path | escape }}" clip-path="url(#{{ clip_id }}-below)" fill="none" stroke="var(--stonks-fall)" vector-effect="non-scaling-stroke" />
            {% else %}
              <path data-stonks-line d="{{ line_path | escape }}" fill="none" stroke="currentColor" vector-effect="non-scaling-stroke" />
            {% endif %}
          </g>
        {% else %}
          <g data-stonks-ohlc stroke="currentColor" stroke-width="{{ line_width }}" stroke-linejoin="miter">
            <path data-stonks-candle="up" d="{{ up_path | escape }}" stroke="var(--stonks-rise)" fill="{% if stonks.chart_type == 'candles' %}var(--stonks-rise-fill){% else %}none{% endif %}" vector-effect="non-scaling-stroke" />
            <path data-stonks-candle="down" d="{{ down_path | escape }}" stroke="var(--stonks-fall)" fill="{% if stonks.chart_type == 'candles' %}var(--stonks-fall){% else %}none{% endif %}" vector-effect="non-scaling-stroke" />
            <path data-stonks-candle="flat" d="{{ flat_path | escape }}" fill="var(--stonks-paper)" vector-effect="non-scaling-stroke" />
            <path d="{{ missing_path | escape }}" fill="none" vector-effect="non-scaling-stroke" />
          </g>
        {% endif %}
        {% if stonks.has_volume == true %}<path data-stonks-volume d="{% for point in stonks.volumes %}M{{ point[0] }},274V{{ point[1] }}{% endfor %}" fill="none" stroke="currentColor" stroke-width="{{ stonks.volume_width }}" />{% endif %}
      </svg>
      {% if line_path != empty %}
        <span class="absolute bg--black rounded--full w--2 h--2" data-stonks-point="{{ direction | escape }}" aria-hidden="true" style="left: 99.428571%; top: {{ stonks.last_y | times: 100.0 | divided_by: 286.0 }}%; transform: translate(-50%, -50%);"></span>
      {% endif %}
    </div>
    <div class="flex flex--row flex--between gap--xsmall w--full no-shrink">
      {% for date in stonks.dates %}<span class="description no-shrink" data-stonks-date{% if forloop.index == 2 %} data-stonks-mid-date{% endif %}>{{ date.label | escape }}</span>{% endfor %}
    </div>
  </div>
  <div class="flex flex--col gap--xsmall h--full no-shrink">
    <div class="stretch relative w--full">
      {% for tick in stonks.ticks %}
        <span class="description absolute right--0" style="top: {{ tick.y | times: 100.0 | divided_by: 286.0 }}%; transform: translateY(-50%);">{{ tick.label | escape }}</span>
      {% endfor %}
      <span class="description" aria-hidden="true" style="visibility: hidden;">{% for tick in stonks.ticks %}{{ tick.label | escape }}<br />{% endfor %}</span>
    </div>
    <span class="description text--right no-shrink">{{ stonks.currency | escape }}</span>
  </div>
</div>
{% endtemplate %}

{% template stonks_unavailable %}
<div class="stretch flex flex--col flex--center gap--small text--center w--full">
  <span class="title title--small">{{ words[0] | escape }}</span>
  <span class="description w--full">{{ stonks.detail | escape }}</span>
  <span class="description w--full">{{ words[7] | escape }}.<br />{{ words[2] | escape }}</span>
</div>
{% endtemplate %}

{% template stonks_footer %}
<div class="title_bar">
  <img class="image image--adaptive w--7 h--7" src="data:image/svg+xml;base64,{{ svg_logo | base64_encode }}" alt="STONKS logo">
  <span class="title">STONKS</span>
  <span class="instance">{% if stonks.has_data == true %}<time class="description" datetime="{{ stonks.market_iso | escape }}" title="{{ words[3] | escape }}: {{ stonks.market_label | escape }}" aria-label="{{ words[3] | escape }}: {{ stonks.market_label | escape }}">{{ stonks.market_label_compact | escape }}</time>{% else %}{{ stonks.symbol | escape }} · {{ range_label | escape }}{% endif %}</span>
</div>
{% endtemplate %}
