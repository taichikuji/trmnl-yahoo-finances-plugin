{% comment %}Framework handles layout; scoped CSS supplies numeric font sizes and chart coordinates.{% endcomment %}
<style>
  [data-stonks] .description, [data-stonks] .label--small { font-size: calc(var(--stonks-font) * var(--text-ui-scale, 1)); }
  /* Framework breakpoints follow devices; this query follows the actual slot. */
  @container (max-width: 360px) { [data-stonks-mid-date] { display: none; } }
</style>
<div class="layout layout--col layout--top gap--small p--2" data-stonks style="--stonks-font: {{ stonks.font_size | default: 10 }}px;">
  <div class="flex flex--row flex--between gap--xsmall w--full no-shrink">
    <span class="title {% if stonks.header == 'large' %}title--base lg:title--large{% elsif stonks.header == 'small' %}title--small{% else %}title--small lg:title--base{% endif %} w--min-0" title="{{ stonks.name | default: stonks.symbol | escape }}">{{ stonks.name | default: stonks.symbol | escape }}</span>
    <span class="label label--small no-shrink">{{ stonks.symbol | escape }}</span>
  </div>
  {% if stonks.has_data == true %}
    {% assign price_characters = stonks.price_label | size %}
    <div class="flex flex--row flex--wrap flex--between flex--bottom gap--xsmall w--full no-shrink">
      <div class="flex flex--row flex--wrap flex--bottom gap--xsmall w--min-0">
        <span class="value {% if price_characters > 15 %}value--xsmall lg:value--small{% elsif price_characters > 10 %}value--small lg:value--base{% elsif stonks.header == 'large' %}value--base lg:value--large{% elsif stonks.header == 'small' %}value--small{% else %}value--base{% endif %} value--tnums no-shrink" data-stonks-price>{{ stonks.price_label | escape }}</span>
        <span class="label label--small pb--1" data-stonks-currency>{{ stonks.currency | escape }}</span>
      </div>
      <div class="flex flex--col flex--right gap--xsmall no-shrink">
        <div class="flex flex--row gap--xsmall">
          <span class="label label--outline">{{ stonks.percent_label | escape }}</span>
          <span class="label label--small">{{ stonks.range_label | escape }}</span>
        </div>
        <span class="description">{{ stonks.absolute_change_label | escape }} {{ stonks.currency | escape }}</span>
      </div>
    </div>
    <div class="flex flex--row flex--between gap--xsmall w--full no-shrink">
      <span class="description w--min-0" title="{{ stonks.detail | escape }} {{ stonks.chart_note | escape }}{% if stonks.fx_iso != '' %} FX: {{ stonks.fx_iso | escape }}{% endif %}">{% if stonks.stale == true %}{{ stonks.detail | escape }}{% else %}{{ stonks.source_label | escape }} · {{ stonks.session_label | escape }}{% if stonks.chart_note != '' %} · {{ stonks.chart_note | escape }}{% endif %}{% endif %}{% if stonks.fx_label != '' %} · {{ stonks.fx_label | escape }}{% endif %}{% if stonks.baseline_label != blank %} · {{ stonks.baseline_label | escape }}{% endif %}</span>
      {% if stonks.stale == true %}<span class="label label--small label--filled no-shrink">{{ stonks.labels.stale | escape }}</span>{% endif %}
    </div>
    <div class="stretch flex flex--row gap--xsmall w--full" data-stonks-chart>
      <div class="stretch flex flex--col gap--xsmall h--full w--min-0">
        <div class="stretch relative w--full">
          <svg class="block" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 700 286" preserveAspectRatio="none" role="img" aria-label="{{ stonks.name | escape }} · {{ stonks.range_label | escape }} · {{ stonks.currency | escape }}">
            <title>{{ stonks.symbol | escape }} · {{ stonks.price_label | escape }} {{ stonks.currency | escape }} · {{ stonks.market_label | escape }}</title>
            {% if stonks.grid == true %}
              {% for tick in stonks.ticks %}<path d="M4,{{ tick.y }}H696" fill="none" stroke="currentColor" stroke-dasharray="1 6" stroke-width="0.5" vector-effect="non-scaling-stroke" />{% endfor %}
              {% for date in stonks.dates %}<path d="M{{ date.x }},12V274" fill="none" stroke="currentColor" stroke-dasharray="1 6" stroke-width="0.5" vector-effect="non-scaling-stroke" />{% endfor %}
            {% endif %}
            {% if stonks.reference == true %}<path d="M4,{{ stonks.reference_y }}H696" fill="none" stroke="currentColor" stroke-dasharray="6 4" stroke-width="1" vector-effect="non-scaling-stroke" />{% endif %}
            {% if stonks.chart_type == 'line' or stonks.has_ohlc != true %}
              <path data-stonks-line d="{{ stonks.path | escape }}" fill="none" stroke="currentColor" stroke-width="{{ stonks.line_width }}" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
            {% else %}
              <g data-stonks-ohlc stroke="currentColor" stroke-width="{{ stonks.line_width }}" stroke-linejoin="miter">
                <path d="{{ stonks.up | escape }}" fill="white" vector-effect="non-scaling-stroke" />
                <path d="{{ stonks.down | escape }}" fill="{% if stonks.chart_type == 'candles' %}currentColor{% else %}none{% endif %}" vector-effect="non-scaling-stroke" />
                <path d="{{ stonks.missing_path | escape }}" fill="none" vector-effect="non-scaling-stroke" />
              </g>
            {% endif %}
            {% if stonks.has_volume == true %}<path data-stonks-volume d="{{ stonks.volume_path | escape }}" fill="none" stroke="currentColor" stroke-width="{{ stonks.volume_width }}" />{% endif %}
          </svg>
          {% if stonks.chart_type == 'line' or stonks.has_ohlc != true %}
            <span class="absolute bg--black rounded--full w--2 h--2" aria-hidden="true" style="left: 99.428571%; top: {{ stonks.last_y | times: 100.0 | divided_by: 286.0 }}%; transform: translate(-50%, -50%);"></span>
          {% endif %}
        </div>
        <div class="flex flex--row flex--between gap--xsmall w--full no-shrink">
          {% for date in stonks.dates %}<span class="description no-shrink" data-stonks-date{% if forloop.index == 2 %} data-stonks-mid-date{% endif %}>{{ date.label | escape }}</span>{% endfor %}
        </div>
      </div>
      <div class="flex flex--col gap--xsmall h--full no-shrink">
        <div class="stretch relative w--full">
          {% for tick in stonks.ticks %}
            <span class="description absolute right--0" style="top: {{ tick.y | times: 100.0 | divided_by: 286.0 }}%; transform: translateY(-50%);">{{ tick.label | escape }}</span>
          {% endfor %}
          <span class="description" aria-hidden="true" style="visibility: hidden;">{% for tick in stonks.ticks %}{{ tick.label | escape }}<br />{% endfor %}</span>
        </div>
        <span class="description text--right no-shrink">{{ stonks.currency | escape }}</span>
      </div>
    </div>
  {% else %}
    <div class="stretch flex flex--col flex--center gap--small text--center w--full">
      <span class="title title--small">{{ stonks.labels.unavailable | escape }}</span>
      <span class="description w--full">{{ stonks.detail | escape }}</span>
      <span class="description w--full">{{ stonks.labels.no_saved | escape }}.<br />{{ stonks.labels.retry | escape }}</span>
    </div>
  {% endif %}
</div>
<div class="title_bar">
  <span class="title">STONKS</span>
  <span class="instance">{% if stonks.has_data == true %}<time class="description" datetime="{{ stonks.market_iso | escape }}" title="{{ stonks.labels.market | escape }}: {{ stonks.market_label | escape }}" aria-label="{{ stonks.labels.market | escape }}: {{ stonks.market_label | escape }}">{{ stonks.market_label_compact | escape }}</time>{% else %}{{ stonks.symbol | escape }} · {{ stonks.range_label | escape }}{% endif %}</span>
</div>
